# Copy this file to docker/.env and replace the placeholder values before starting.

# PostgreSQL credentials
DB_USER=wolfteam
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_BIND_IP=127.0.0.1
DB_PORT=5436

# Server IP addresses advertised to game clients (IPv4)
# For local play use 127.0.0.1; for VDS/LAN play use your server's public or LAN IPv4.
ADVERTISED_IP=127.0.0.1
PUBLIC_IP=127.0.0.1

# Protocol mode:
#   false = 2013 TR client (default)
#   true  = September 2012 TR client compatibility mode
WT_CLIENT_2012=false

# W-Pack (K-Paket) shop dialog:
#   true  = enabled (2013 TR client includes W-Pack UI textures)
#   false = recommended when WT_CLIENT_2012=true
WT_WPACK_ENABLED=true

# UDP peer endpoint relay mode (2 = room-scoped relay via server, best behind NAT/Docker)
PEER_ENDPOINT_MODE=2

# HTTP patcher / registration / healthz ports
HTTP_PORT=80
LAUNCHER_HTTP_PORT=8080
PATCH_PUBLIC_URL=

# Optional client version values
LAUNCHER_PATCH_VERSION=20
GAME_PATCH_VERSION=377

# Optional directory containing Avital/Apex update files (leave default empty dir if unused)
APEX_WEB_DIR=./apex-web
